{
  "schema": 1,
  "seats": {
    "kernel": "内核",
    "credentials": "凭据、门与脱敏",
    "pi": "pi 运行时",
    "host-ci": "主机与 CI",
    "docs": "文档与流程",
    "ux": "控制台 UX 验收"
  },
  "stewardOnly": ["docs/STATUS.md", "docs/development-tasks.md", "docs/status-history.md"],
  "rules": [
    {
      "name": "脱敏、凭据与门（内核）",
      "risk": "R3",
      "seats": ["credentials", "kernel"],
      "paths": [
        "packages/kernel/src/**/redaction/**",
        "packages/kernel/src/governance/**",
        "packages/kernel/src/application/gateway/**",
        "packages/kernel/src/application/gates/**",
        "packages/kernel/src/application/identity/**",
        "packages/kernel/migrations/governance/**"
      ]
    },
    {
      "name": "凭据代理、门与出网",
      "risk": "R3",
      "seats": ["credentials"],
      "paths": [
        "packages/llm-proxy/**",
        "packages/gatekeeper-base/**",
        "packages/egress-proxy/**",
        "gatekeepers/**",
        "scripts/gen-handle-keys.sh",
        "scripts/derive-internal-tokens.sh",
        "scripts/host-llm-proxy-init.sh",
        "scripts/check-membership-capabilities-not-in-handle-scope.sh",
        "scripts/check-operator-handle-cli-only.sh",
        ".gitleaks.toml",
        ".gitleaksignore"
      ]
    },
    {
      "name": "控制台的凭据入口",
      "risk": "R3",
      "seats": ["credentials", "ux"],
      "paths": [
        "packages/web/src/components/handles/**",
        "packages/web/src/components/connect/**",
        "packages/web/src/components/platform/providers/**"
      ]
    },
    {
      "name": "隔离与部署边界",
      "risk": "R3",
      "seats": ["host-ci", "credentials"],
      "paths": ["docker-compose.yml", "packages/worker-supervisor/**", "deploy/worker-runtime/**", "deploy/caddy/**"]
    },
    {
      "name": "CI、发版与供应链",
      "risk": "R3",
      "seats": ["host-ci"],
      "paths": [
        ".github/workflows/**",
        ".github/CODEOWNERS",
        "deploy/image-mirrors.json",
        "release-please-config.json",
        ".release-please-manifest.json",
        "scripts/guards/**",
        "scripts/pr-gate.mjs",
        "scripts/review-route.mjs",
        "scripts/ci-docs-only.sh",
        "scripts/build-images.sh",
        "scripts/pull-images.sh",
        "scripts/image-pins.mjs",
        "scripts/release-channel.mjs",
        "scripts/apply-release.sh",
        "**/Dockerfile",
        "pnpm-lock.yaml"
      ]
    },
    {
      "name": "仓库与构建配置",
      "risk": "R2",
      "seats": ["host-ci"],
      "paths": [
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.base.json",
        "vitest.base.ts",
        "biome.json",
        ".dependency-cruiser.cjs",
        ".dockerignore",
        ".env.example",
        ".gitattributes",
        ".gitignore"
      ]
    },
    {
      "name": "pi 运行时",
      "risk": "R2",
      "seats": ["pi"],
      "paths": ["pi.version", "packages/agent-host/**", "packages/platform-extension/**"]
    },
    {
      "name": "迁移、线上契约与本体",
      "risk": "R2",
      "seats": ["kernel"],
      "paths": ["packages/kernel/migrations/**", "docs/contracts/**", "packages/shared/**", "ontology/**", "packs/**"]
    },
    {
      "name": "流程规则",
      "risk": "R2",
      "seats": ["docs"],
      "paths": ["CLAUDE.md", "docs/state/**", "docs/runbooks/dev-loop.md", ".github/PULL_REQUEST_TEMPLATE.md"]
    },
    {
      "name": "内核",
      "risk": "R1",
      "seats": ["kernel"],
      "paths": ["packages/kernel/**"]
    },
    {
      "name": "控制台",
      "risk": "R1",
      "seats": ["ux"],
      "paths": ["packages/web/**", "design-system/**"]
    },
    {
      "name": "发版手册里随 PR 写的主机步骤",
      "risk": "R0",
      "seats": [],
      "paths": ["docs/runbooks/release.md"]
    },
    {
      "name": "主机脚本、部署与手册",
      "risk": "R1",
      "seats": ["host-ci"],
      "paths": ["scripts/**", "deploy/**", "docs/runbooks/**", "Makefile", "collectors/**", "connectors/**", "explorer/**", "config/**"]
    },
    {
      "name": "文档",
      "risk": "R0",
      "seats": [],
      "paths": ["docs/**", "*.md", "LICENSE"]
    }
  ],
  "default": { "name": "未归类", "risk": "R1", "seats": ["kernel"] }
}
