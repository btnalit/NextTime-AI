# deploy/ci/env.ci.template — CI-only `.env` values for the web console e2e workflow
# (.github/workflows/e2e.yml). That workflow copies this file to `./.env`, substituting
# `__NEXTTIME_DATA__` for the job's own ephemeral `$RUNNER_TEMP` path — every other value below is
# fixed and safe to reuse verbatim across every CI run: `KERNEL_BIND_ADDR=127.0.0.1` (loopback —
# never exposes the stack beyond the runner itself) and the two subnets are the same RFC 5737
# documentation-only ranges `.env.example` already uses as its own placeholder example, here used
# for real inside the CI runner's own isolated, throwaway Docker networks — never a real
# deployment's actual host/subnet (see docs/runbooks/web-console.md "CI（Playwright）" for why
# this is a *separate* file from `.env.example` rather than that file with real values plugged
# in: `.env.example` documents the real-deployment shape including services this workflow never
# starts — agent-host/worker-supervisor/egress-proxy/gatekeepers — this one is the deliberately
# smaller CI shape).
#
# Reproduce the CI stack locally (Linux/macOS with Docker; mirrors `.github/workflows/e2e.yml`
# step-for-step, minus checkout/pnpm-setup which a local checkout already has):
#
#   export NEXTTIME_DATA=$(mktemp -d)
#   sed "s#__NEXTTIME_DATA__#$NEXTTIME_DATA#" deploy/ci/env.ci.template > .env
#   sudo env NEXTTIME_DATA="$NEXTTIME_DATA" sh scripts/host-bootstrap.sh
#   sudo env NEXTTIME_DATA="$NEXTTIME_DATA" sh scripts/host-env-init.sh
#   sudo env NEXTTIME_DATA="$NEXTTIME_DATA" sh scripts/gen-handle-keys.sh
#   sudo cp config/llm-providers.fake.example.yaml "$NEXTTIME_DATA/config/llm-providers.yaml"
#   echo 'FAKE_LLM_API_KEY=fake' | sudo tee -a "$NEXTTIME_DATA/secrets/llm-proxy.env" >/dev/null
#
#   sudo docker compose -f docker-compose.yml -f deploy/ci/docker-compose.ci.yml \
#     build kernel caddy llm-proxy
#   sudo docker compose -f docker-compose.yml -f deploy/ci/docker-compose.ci.yml \
#     run --rm --no-deps -T llm-proxy node dist/cli/gen-models.js \
#     | sudo tee "$NEXTTIME_DATA/config/models.json" >/dev/null
#   sudo docker compose -f docker-compose.yml -f deploy/ci/docker-compose.ci.yml \
#     up -d --wait postgres
#   # Migrations MUST run before `kernel` (next step) is ever started — see .github/workflows/
#   # e2e.yml's own comment on this same ordering for why (kernel's one-time startup recovery
#   # scan throws on a not-yet-migrated database and silently skips starting its own outbox
#   # dispatcher, so every chat Turn would hang at "running" forever).
#   sudo docker compose -f docker-compose.yml -f deploy/ci/docker-compose.ci.yml \
#     run --rm --no-deps -T kernel node dist/cli/migrate.js
#   sudo docker compose -f docker-compose.yml -f deploy/ci/docker-compose.ci.yml \
#     up -d --wait kernel caddy
#   until curl -sk -o /dev/null -w '%{http_code}' https://127.0.0.1:8443/api/health | grep -q 200; do sleep 2; done
#   sudo docker compose -f docker-compose.yml -f deploy/ci/docker-compose.ci.yml \
#     run --rm --no-deps -T kernel node dist/cli/bootstrap.js create-workspace --name ci-e2e --owner owner
#   # ^ prints the owner API key once — pass it below.
#
#   WEB_E2E_BASE_URL=https://127.0.0.1:8443 WEB_E2E_API_KEY=<printed key> \
#     corepack pnpm --filter @nexttime/web e2e
#
#   sudo docker compose -f docker-compose.yml -f deploy/ci/docker-compose.ci.yml down -v

# Host data root — substituted by the workflow (see header). Every persistent path in
# docker-compose.yml lives under here, same as a real deployment's own NEXTTIME_DATA
# (.env.example) — just pointed at a throwaway directory this job deletes with the runner VM.
NEXTTIME_DATA=__NEXTTIME_DATA__

# Loopback-only: caddy is the one service that publishes a host port (docker-compose.yml
# `ports: ["${KERNEL_BIND_ADDR:?}:8443:8443"]`) — never bind it wider than the runner itself needs.
KERNEL_BIND_ADDR=127.0.0.1
KERNEL_PUBLIC_URL=https://127.0.0.1:8443

# RFC 5737 documentation ranges (same placeholder values `.env.example` shows) — real subnets only
# inside this job's own throwaway Docker networks, never a real host's.
NEXTTIME_SUBNET_CONTROL=203.0.113.0/24
NEXTTIME_SUBNET_WORKERS=203.0.114.0/24

# No gVisor on a GitHub-hosted runner; unused anyway (see below) but kept at the code's own
# conservative fallback rather than left to default to `.env.example`'s `runsc`.
WORKER_RUNTIME=runc

# The whole point of this CI stack: `packages/kernel/src/application/host-bridge/fake-runtime.ts`
# echoes chat replies from inside the kernel process, so no agent-host/worker-supervisor/
# docker-socket-proxy/egress-proxy container (and no docker-in-docker for resident containers) is
# needed for login/chat/approvals/governance — see docs/runbooks/web-console.md "CI（Playwright）"
# "为什么只需要三个常驻容器".
AGENT_RUNTIME=fake

TZ=UTC
