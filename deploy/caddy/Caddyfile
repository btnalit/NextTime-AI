# deploy/caddy/Caddyfile
#
# caddy is NextTime-AI's only public-facing service (design doc §11: 只有 caddy 有公网面；内核
# 不发布端口). TLS uses Caddy's internal CA (`tls internal`) — self-signed is acceptable for S1
# (design doc §11: 内网 CA 或自签). See docs/runbooks/host-caddy.md for how to trust the
# generated root CA on a client and for the placeholder-vs-real static root switch.
#
# No plaintext :80 listener: docs/development-tasks.md §E8 does not ask for an HTTP->HTTPS
# redirect. `auto_https disable_redirects` turns off Caddy's default "also add a :80 redirect
# helper" behavior that otherwise applies to any TLS-enabled site, hostname or not.
{
	auto_https disable_redirects
	# The internal issuer clamps a leaf's lifetime to its intermediate's NotAfter, and the
	# intermediate defaults to 7 days — so the site block's `lifetime 2160h` below would silently
	# become ≤7d (review lane 7). Stretch the intermediate to 100 days so a leaf really lasts ~90.
	pki {
		ca local {
			intermediate_lifetime 2400h
		}
	}
}

# The scheme prefix is required, not decorative: a bare ":8443" (no scheme, no hostname, non-
# standard port) is a documented Caddy ambiguity (caddyserver/caddy#5747) — Caddy ends up
# without a real TLS connection policy for the listener, and handshakes fail with a
# "tlsv1 alert internal error". "https://:8443" makes the connection policy explicit.
#
# `on_demand` is required too: automatic HTTPS only provisions certificates for hostnames it
# knows about from the Caddyfile (docs: "Caddy implicitly activates automatic HTTPS when it
# knows a domain name or IP address it is serving") — a hostless catch-all like this one has no
# name to provision eagerly, so without on_demand every handshake fails the same way (no
# certificate for the connection → TLS "internal error" alert), regardless of the scheme fix
# above. Caddy's docs flag unrestricted on_demand as insecure in production unless paired with
# a global `on_demand_tls { ask ... }` permission check; accepted here for S1 (design doc §11:
# 自签 acceptable for S1) because the issuer is `internal` (self-signed, not rate-limited public
# ACME — the only abuse cost is local CPU/disk generating extra certs for junk SNI values on an
# internal-only tool) and KERNEL_BIND_ADDR is not meant to be internet-reachable. Revisit if
# this deployment is ever exposed beyond a trusted network.
https://:8443 {
	# Internal CA, on-demand leaf per requested host. `lifetime` raises the leaf certificate
	# validity from Caddy's 12h default: a browser's per-fingerprint "proceed anyway" exception
	# dies with every leaf rotation, so at 12h the LAN operator saw the interstitial twice a day
	# (S2.12 host run). The proper fix is still importing the internal root
	# (`${NEXTTIME_DATA}/caddy/caddy/pki/authorities/local/root.crt`) into the client's trust store —
	# see docs/runbooks/web-console.md 排障; this only makes the untrusted path tolerable.
	tls {
		issuer internal {
			lifetime 2160h
		}
		on_demand
	}

	# Access log to stdout as JSON. Caddy's access log never includes request/response bodies
	# (there is no body-logging directive to accidentally enable) — only method/path/status/
	# duration/size-shaped fields.
	log {
		output stdout
		format json
	}

	# Baseline security headers reasonable for an internal tool. No Strict-Transport-Security:
	# this deployment's TLS is an internal/self-signed CA (see runbook), and HSTS pinning could
	# strand a client across a future CA rotation.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# S3.5 / W7 (docs/development-tasks.md §S3.5; design doc §9.5) — the nine Explorer endpoints
	# used to be matched and handled here as a separate `@explorer_api` block so caddy could inject
	# a shared `X-API-Key` header. Since W7 each caller authenticates itself — its own `X-API-Key`,
	# or (S4.1, packages/kernel/src/application/identity/console-session.ts) the console session
	# cookie `nexttime_console_session` a password login installs, plus the `nexttime_workspace`
	# selector cookie — so these nine paths are ordinary `/api/*` routes now and simply fall
	# through to the @backend block below. caddy deliberately holds no Explorer credential any more.

	# Reverse-proxied to the kernel exactly as docs/development-tasks.md §E8 states ("反代 /api
	# /ws /mcp /llm 到 kernel"). reverse_proxy handles the WebSocket upgrade for /ws
	# transparently — no extra directives needed. Everything under /api/* (the nine Explorer paths,
	# §9.3's own capability route, /api/health, ...) reaches the kernel here, with no header
	# injected — callers authenticate themselves.
	#
	# S3.6 fix: the E8 matcher below originally had only `/mcp/*` (no bare `/mcp`) — anticipatory,
	# written before the MCP gateway existed. The real endpoint (interfaces/mcp/index.ts,
	# `registerMcpRoute`) is a single streamable-HTTP POST at the bare path `/mcp` (no sub-path;
	# see docs/howto-connect-claude-code.md's `url: https://<host>:8443/mcp`), which Caddy's `path`
	# matcher only matches literally — `/mcp/*` requires a trailing `/` + more, so a bare `/mcp`
	# request fell through to the web-SPA catch-all below and 404'd. `/mcp` is added alongside the
	# pre-existing `/mcp/*` (kept for forward compatibility, e.g. a future sub-resource) — matching
	# the literal §E8 text ("/mcp", same as the already-bare "/ws").
	#
	# NOTE raised in the PR, not decided here: design doc §7.7 / §10.2 describe a separate
	# `llm-proxy` service for provider traffic. Routing /llm/* to `kernel` instead of
	# `llm-proxy` may be a documentation gap in §E8 — kept as the task doc states.
	@backend path /api/* /ws /mcp /mcp/* /llm/*
	handle @backend {
		reverse_proxy kernel:8080
	}

	# P-B2a (docs/development-tasks.md P-B 决定 ⑩): the ONLY path that bypasses the kernel — the
	# browser posts a gate instance's credential straight to the generic gate host, authenticated by
	# a 5-minute platform JWT the kernel signed (the host verifies it with config/handle.pub). The
	# kernel never sees the credential. `handle_path` strips `/gate-host`, so
	# `/gate-host/i/<gateId>/gate/connected-accounts` reaches the host as `/i/<gateId>/gate/...`;
	# every other `/i/*` route there still demands gate_token, which no browser has.
	handle_path /gate-host/* {
		reverse_proxy gate-host:8083
	}

	# Explorer (S3.5) static build — deploy/caddy/explorer-placeholder/, copied into the image at
	# /srv/explorer by deploy/caddy/Dockerfile (a placeholder page by default; a real built bundle
	# once a host operator has run `sh explorer/build.sh` — see explorer/README.md and
	# docs/runbooks/host-explorer.md). `handle_path` strips the `/explorer` prefix before serving,
	# matching the `--base=/explorer/` the build script passes to `vite build`.
	handle_path /explorer/* {
		root * /srv/explorer
		file_server
		try_files {path} /index.html
	}

	# Web UI (S1.8) static build, baked into this image by deploy/caddy/Dockerfile from
	# packages/web/dist — see docs/runbooks/host-caddy.md §E8.5 for the rebuild step.
	handle {
		root * /srv/web
		file_server
		try_files {path} /index.html
	}
}
