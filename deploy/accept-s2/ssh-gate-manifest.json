[
  {
    "name": "ssh.run_command",
    "binding": { "kind": "ssh", "command_pattern": ".*" },
    "params_schema": {
      "type": "object",
      "properties": { "command": { "type": "string" } },
      "required": ["command"]
    },
    "mode": "execute",
    "blast_radius": "medium",
    "reversibility": false,
    "auto_approvable": true,
    "await_decision": false,
    "reads": [],
    "writes": []
  }
]
