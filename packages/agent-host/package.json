{
  "name": "@nexttime/agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event bridge for the per-user resident entry agent container: applies for/stops the entry container via worker-supervisor, requests an entry Handle from the kernel, and bridges the container's JSONL stdout events to kernel host-bridge (design doc §7.2).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nexttime/shared": "workspace:*",
    "dockerode": "^5.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/ws": "^8.5.13"
  }
}
