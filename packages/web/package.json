    "dev": "vite",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nexttime/shared": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^30.0.1",
    "vite": "^6.0.7"
  }
}
