{
  "name": "@nexttime/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React + Vite SPA served statically by caddy: chat, approvals, tasks, connections, audit/explain (design doc §7.6). `dist/` is the Vite static build, mounted read-only by the caddy service in docker-compose.yml (§10.2).",
  "scripts": {
