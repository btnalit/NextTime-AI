    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@nexttime/shared": "workspace:*",
    "typebox": "^1.3.7",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4"
  }
