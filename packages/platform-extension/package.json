{
  "name": "@nexttime/platform-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The single shared pi extension, driven by NEXTTIME_MODE (entry/worker/interactive) — design doc §7.4.",
  "main": "dist/index.js",
