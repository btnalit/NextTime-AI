{
  "name": "@nexttime/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify + ws + pg kernel: gateway, chat, ontology, graph, epistemic, policy, approval, capability, task, host-bridge, connections, llm-usage, mcp, explorer-contract, audit (design doc §7.1).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/cli/migrate.js",
    "bootstrap": "node dist/cli/bootstrap.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nexttime/gatekeeper-base": "workspace:*",
    "@nexttime/shared": "workspace:*",
    "fastify": "^5.12.6",
    "jmespath": "^0.16.0",
    "jose": "^6.2.10",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jmespath": "^0.15.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13"
  }
