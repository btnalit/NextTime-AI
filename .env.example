# Copy to .env and fill in real values for the target host. This file must only ever contain
# placeholders — real hostnames, subnets, paths and credentials for the current deployment live
# in docs/private/ (not tracked; see docs/development-tasks.md §0.2).

# Host data root; every persistent volume in docker-compose.yml lives under this path
# (pgdata/, workspaces/, secrets/, config/, artifacts/, backups/, caddy/, gatekeepers/ — see
# docs/graph-ai-middle-platform-design.md §10.2). `sessions/` is not one of them — that top-level
# directory was removed (2026-09-02, docs/runbooks/host-worker-runtime.md's own note); it was
# never used by any service.
NEXTTIME_DATA=/path/to/example/data

# Address caddy's HTTPS entrypoint binds to on the host. The kernel itself never publishes a
# host port. RFC 5737 documentation address shown here — replace with the real host address.
KERNEL_BIND_ADDR=192.0.2.10

# Public URL the web UI / kernel API are reachable at (docs/development-tasks.md §E8). Not yet
# read by any service in this repo — S1.5/S1.8 are expected to consume it (e.g. OAuth-style
# redirect URIs, links rendered in the web UI); added now per E8's deliverable list.
KERNEL_PUBLIC_URL=https://192.0.2.10:8443

# Docker network subnets for the control plane and the (internal-only) worker plane.
# RFC 5737 documentation ranges shown here — replace with real, non-overlapping subnets.
NEXTTIME_SUBNET_CONTROL=203.0.113.0/24
NEXTTIME_SUBNET_WORKERS=203.0.114.0/24

# Worker/entry container runtime: runsc (gVisor) is the *recommended* value, set explicitly here
# for a new deployment — it isn't the underlying code default. worker-supervisor's own fallback
# when WORKER_RUNTIME is unset entirely (packages/worker-supervisor/src/config.ts loadConfig) is
# the more conservative `runc`, which works on any host without gVisor installed; this file
# deliberately overrides that fallback to `runsc` because gVisor's syscall-filtering sandbox is
# the stronger isolation boundary once E1 (docs/development-tasks.md) has verified it actually
# works on the target host — do not skip that verification and assume this value alone is enough
# (lane-6 review P3: this line existing without E1 having run would silently degrade to whatever
# runsc does on an unverified host, not to the code's own safe `runc` fallback). Set to `runc`
# here yourself if gVisor genuinely isn't available.
WORKER_RUNTIME=runsc

# egress-proxy: comma-separated CIDRs owned by a transparent ("fake-IP") proxy on the host's
# network — a resolver that answers every public name from such a range would otherwise trip the
# proxy's DNS-rebinding guard (I10) and deny all public egress. Hostnames resolving into these
# ranges are treated as public; literal IPs and the platform subnets are still denied. Leave
# empty on a normal network. Example value for the common fake-IP default: 198.18.0.0/15
EGRESS_TRUSTED_RESOLVED_CIDRS=

# egress-proxy: extra hostname suffixes to deny by name, appended to the built-in private-network
# suffixes (localhost, local, lan, home.arpa, internal). Set it to your site's own LAN domain(s)
# — on a fake-IP host a LAN name resolves into the trusted range above just like a public one, so
# the name is the only signal left. Comma-separated, no leading dot. Example: corp.example,intra
EGRESS_DENY_HOST_SUFFIXES=

# gid of the host's `docker` group, which owns /var/run/docker.sock (mode 660) — was needed as a
# supplementary group (docker-compose.yml `group_add`) by non-root uid-10001 containers that
# bind-mount the socket directly. As of fix/gate-docker-socket-proxy, NO compose service reads
# this any more: worker-supervisor and agent-host stopped bind-mounting docker.sock under
# fix/socket-proxy-and-backup-user (talk to it through `docker-socket-proxy` over the `dockerapi`
# network instead), and `gatekeeper-docker` — the last direct consumer — now goes through its own
# `docker-socket-proxy-gate` instance over `dockerapi-gate` instead (see docker-compose.yml's
# comment on those services). Left here as a harmless unused placeholder rather than deleted (an
# operator's existing `.env` may still set it); safe to remove once you've confirmed nothing else
# on your host reads it. `docker.sock` itself is now bind-mounted only into
# `docker-socket-proxy`/`docker-socket-proxy-gate`, both of which run as root and need no gid.
DOCKER_GID=999

# Which AgentRuntime the kernel constructs (packages/kernel/src/index.ts
# resolveAgentRuntimeKind): "agent-host" (default — the real pi-backed runtime over agent-host's
# WebSocket bridge, docs/development-tasks.md S1.5 second half) or "fake" (FakeAgentRuntime, S1.4
# — echoes the prompt back with no container/pi involved at all; useful for isolating a chat/WS
# issue from the whole agent-host/worker-runtime stack). Uncomment to override:
# AGENT_RUNTIME=fake

# `backup` service (task S1.12; docs/graph-ai-middle-platform-design.md §10.2/§10.4/§13):
# container timezone — controls both its log timestamps and when BACKUP_TIME fires.
TZ=UTC

# Local time (HH:MM, 24h, in $TZ) the daily pg_dump + files backup runs.
BACKUP_TIME=03:30

# How many daily backups to keep (db dumps and files tarballs are pruned independently).
BACKUP_RETENTION=7

# worker-supervisor one-shot Task mode (S2.8; docs/graph-ai-middle-platform-design.md §7.3, §7.9).
# Both already have safe defaults (packages/worker-supervisor/src/config.ts) — uncomment only to
# override. TASK_MAX_RUNTIME_SEC: seconds before the reaper kills a still-running Worker container
# (a per-request timeoutSec, when given, overrides this on a per-Task basis).
# TASK_MAX_RUNTIME_SEC=3600

# TASK_WORKDIR_RETENTION_HOURS: how long a finished Task's workspace directory is kept as an
# artifact before the retention sweep deletes it.
# TASK_WORKDIR_RETENTION_HOURS=72

# MODELS_JSON_HOST_PATH (packages/worker-supervisor/src/config.ts): overrides where spawned
# containers' read-only models.json bind mount is sourced from on the host — default is
# ${NEXTTIME_DATA}/config/models.json, the file `make gen-models` writes for the real provider.
# Set only by deploy/accept/docker-compose.fake.yml (W6), to point acceptance runs at a
# separately generated fake-provider file without touching the production one. Leave unset in a
# real deployment.
# MODELS_JSON_HOST_PATH=

# Outbox prune loop (packages/kernel/src/index.ts createBackgroundServices) — both already have
# safe defaults, uncomment only to override. OUTBOX_PRUNE_DAYS: delete dispatched outbox rows
# older than this many days; 0 disables the prune loop entirely (nothing is ever deleted).
# OUTBOX_PRUNE_DAYS=7

# OUTBOX_PRUNE_INTERVAL_MS: how often the prune tick runs (the very first tick fires shortly
# after kernel startup, not after a full interval).
# OUTBOX_PRUNE_INTERVAL_MS=21600000

# Invariant-check loop (S3.8, packages/kernel/src/index.ts createBackgroundServices /
# substrate/audit/invariant-checks.ts) — already has a safe default, uncomment only to override.
# INVARIANT_CHECK_INTERVAL_MS: how often the design doc §5.4 I1-I16 scan runs (the very first tick
# fires shortly after kernel startup, not after a full interval); 0 disables the loop entirely.
# INVARIANT_CHECK_INTERVAL_MS=600000

# Explorer mount (S3.5, docs/development-tasks.md §S3.5; docs/runbooks/host-explorer.md) — the API
# key of a dedicated, least-privileged (`member`-role) Principal every Explorer static-bundle
# viewer is attributed to (caddy injects it as `X-API-Key` on the nine Explorer API paths — the
# unmodified bundle sends no auth header itself; see deploy/caddy/Caddyfile's own comment). Left
# unset here (Explorer's API calls all 401 until this is set — fails closed, not silently open) —
# create the Principal (`create_principal` capability, host-explorer.md §1) and paste its one-time
# API key below.
# EXPLORER_API_KEY=

# Explorer bundle build (W4 closeout; deploy/caddy/Dockerfile's "Explorer bundle selection" stage;
# docs/runbooks/host-explorer.md) — controls whether `docker compose build caddy` itself clones
# and builds the third-party Explorer static bundle (semantica-agi/semantica's own explorer/
# subdirectory), on a host with Docker only (no node/npm/git needed on the host itself). Both
# already default inside the Dockerfile (0 / v0.6.7) — leaving both commented out here reproduces
# the exact prior behavior (the committed "bundle not built" placeholder page, no network access
# during the build). Set EXPLORER_BUILD=1 to build the real bundle instead (needs network access
# during `docker compose build caddy` — it clones SEMANTICA_REF).
# EXPLORER_BUILD=1
# SEMANTICA_REF=v0.6.7
