# Copy to .env and fill in real values for the target host. This file must only ever contain
# placeholders — real hostnames, subnets, paths and credentials for the current deployment live
# in docs/private/ (not tracked; see docs/development-tasks.md §0.2).

# Host data root; every persistent volume in docker-compose.yml lives under this path
# (pgdata/, sessions/, workspaces/, secrets/, config/, artifacts/, backups/, caddy/ — see
# docs/graph-ai-middle-platform-design.md §10.2).
NEXTTIME_DATA=/path/to/example/data

# Address caddy's HTTPS entrypoint binds to on the host. The kernel itself never publishes a
# host port. RFC 5737 documentation address shown here — replace with the real host address.
KERNEL_BIND_ADDR=192.0.2.10

# Public URL the web UI / kernel API are reachable at (docs/development-tasks.md §E8). Not yet
# read by any service in this repo — S1.5/S1.8 are expected to consume it (e.g. OAuth-style
# redirect URIs, links rendered in the web UI); added now per E8's deliverable list.
KERNEL_PUBLIC_URL=https://192.0.2.10:8443

# Docker network subnets for the control plane and the (internal-only) worker plane.
# RFC 5737 documentation ranges shown here — replace with real, non-overlapping subnets.
NEXTTIME_SUBNET_CONTROL=203.0.113.0/24
NEXTTIME_SUBNET_WORKERS=203.0.114.0/24

# Worker/entry container runtime: runsc (gVisor, default) or runc as a fallback if gVisor isn't
# available on the target host (see docs/development-tasks.md E1).
WORKER_RUNTIME=runsc

# egress-proxy: comma-separated CIDRs owned by a transparent ("fake-IP") proxy on the host's
# network — a resolver that answers every public name from such a range would otherwise trip the
# proxy's DNS-rebinding guard (I10) and deny all public egress. Hostnames resolving into these
# ranges are treated as public; literal IPs and the platform subnets are still denied. Leave
# empty on a normal network. Example value for the common fake-IP default: 198.18.0.0/15
EGRESS_TRUSTED_RESOLVED_CIDRS=

# egress-proxy: extra hostname suffixes to deny by name, appended to the built-in private-network
# suffixes (localhost, local, lan, home.arpa, internal). Set it to your site's own LAN domain(s)
# — on a fake-IP host a LAN name resolves into the trusted range above just like a public one, so
# the name is the only signal left. Comma-separated, no leading dot. Example: corp.example,intra
EGRESS_DENY_HOST_SUFFIXES=

# gid of the host's `docker` group, which owns /var/run/docker.sock (mode 660) — worker-
# supervisor and agent-host both run as non-root uid 10001 (packages/worker-supervisor/Dockerfile,
# packages/agent-host/Dockerfile) and need this as a supplementary group to reach the socket
# (docker-compose.yml `group_add` on both services — agent-host's own mount is read-only, but
# group membership still governs read access to the socket file itself), or they crash-loop with
# EACCES. Find it with `stat -c '%g' /var/run/docker.sock` — it varies by host/distro; 999 (shown
# here) is only a common default, not guaranteed.
DOCKER_GID=999

# Which AgentRuntime the kernel constructs (packages/kernel/src/index.ts
# resolveAgentRuntimeKind): "agent-host" (default — the real pi-backed runtime over agent-host's
# WebSocket bridge, docs/development-tasks.md S1.5 second half) or "fake" (FakeAgentRuntime, S1.4
# — echoes the prompt back with no container/pi involved at all; useful for isolating a chat/WS
# issue from the whole agent-host/worker-runtime stack). Uncomment to override:
# AGENT_RUNTIME=fake

# `backup` service (task S1.12; docs/graph-ai-middle-platform-design.md §10.2/§10.4/§13):
# container timezone — controls both its log timestamps and when BACKUP_TIME fires.
TZ=UTC

# Local time (HH:MM, 24h, in $TZ) the daily pg_dump + files backup runs.
BACKUP_TIME=03:30

# How many daily backups to keep (db dumps and files tarballs are pruned independently).
BACKUP_RETENTION=7

# worker-supervisor one-shot Task mode (S2.8; docs/graph-ai-middle-platform-design.md §7.3, §7.9).
# Both already have safe defaults (packages/worker-supervisor/src/config.ts) — uncomment only to
# override. TASK_MAX_RUNTIME_SEC: seconds before the reaper kills a still-running Worker container
# (a per-request timeoutSec, when given, overrides this on a per-Task basis).
# TASK_MAX_RUNTIME_SEC=3600

# TASK_WORKDIR_RETENTION_HOURS: how long a finished Task's workspace directory is kept as an
# artifact before the retention sweep deletes it.
# TASK_WORKDIR_RETENTION_HOURS=72
